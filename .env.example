SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/shuttleflow
DB_USERNAME=shuttleflow_admin
DB_PASSWORD=replace-with-local-password
APP_BASE_URL=http://localhost:8080
APP_REGISTRATION_ENABLED=true

# Required only with SPRING_PROFILES_ACTIVE=prod
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=no-reply@example.com
DEMO_REQUEST_RECIPIENT=victor@renatus.technology

# Manager exception detection
ATTENTION_START_GRACE_MINUTES=10
ATTENTION_OVERRUN_GRACE_MINUTES=10

# Schedule privacy + forecasting history
SCHEDULE_RETENTION_ENABLED=true
SCHEDULE_RETENTION_CRON=0 15 2 * * *
FORECAST_HISTORY_MONTHS=12

# Production monitoring / Sentry (recommended in prod)
# SENTRY_DSN is created by the Sentry project. Leave blank locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=routepulse-production
SENTRY_ERROR_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.0

# Optional logical database backup / restore tooling. Railway native volume
# backups are the primary production backup layer; these values are for a
# portable SQL backup or restore drill when needed.
DB_BACKUP_HOST=
DB_BACKUP_PORT=3306
DB_BACKUP_NAME=
DB_BACKUP_USERNAME=
DB_BACKUP_PASSWORD=
